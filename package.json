{
  "name": "@taraspace/cli",
  "version": "0.1.0",
  "description": "Tara Workspace CLI — control your canvas and projects from the terminal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agkomyint/tara-cli.git"
  },
  "homepage": "https://github.com/agkomyint/tara-cli#readme",
  "bugs": {
    "url": "https://github.com/agkomyint/tara-cli/issues"
  },
  "type": "module",
  "bin": {
    "tara": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "npm run clean && tsc && node --test dist/agent-workflow.test.js dist/commands/canvas/spec.test.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run test && npm run build"
  },
  "dependencies": {
    "@taraspace/canvas-core": "^0.1.1",
    "@clack/prompts": "^1.7.0",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tara",
    "workspace",
    "cli",
    "canvas"
  ]
}
